+++ b/src/nomo/application/mutations/controller.es
@@ -0,0 +1,55 @@
+module nomo.application.mutations.controller;
+
+import nomo.application.mutations.ports.{MutationService, MutationFileAccess, ChangeJournalStore, MutationHistoryStore, MutationOutputSink};
+import nomo.application.mutations.handlers;
+import nomo.application.conversation.ports.ConversationReader;
+import nomo.application.commands.effects.CommandOperations;
+import nomo.domain.mutations.models.{Change, ChangeOutcome, Journal, FileChange, FileOutcome};
+import nomo.native.workspace.ProjectRoot;
+import std.effects.Fs;
+import std.fs.{ReadLimitError, IOError as FileError};
+import std.io.IOError as ConsoleError;
+
+public type Mutations<Files ~ MutationFileAccess, Journals ~ ChangeJournalStore, History ~ MutationHistoryStore + ConversationReader, Output ~ MutationOutputSink> = {
+    @inject files: Files,
+    @inject journals: Journals,
+    @inject history: History,
+    @inject output: Output,
+};
+
+impl Mutations<Files ~ MutationFileAccess, Journals ~ ChangeJournalStore, History ~ MutationHistoryStore + ConversationReader, Output ~ MutationOutputSink> ~ MutationService {
+    flow apply(self, session: string, name: string, changes: Array<Change>) -> ChangeOutcome
+        ![CommandOperations, Memory, Console, Command.run<DefaultCommandSandbox>, Fs.read<ProjectRoot>, Fs.list<ProjectRoot>, Fs.atomic_replace<ProjectRoot>, Error<StorageError>, Error<MemoryConflict>, Error<FileError>, Error<ReadLimitError>, Error<ConsoleError>, Error<BudgetExceeded>] {
+        return handlers.execute(self.files, self.journals, self.history, self.output, session, "apply", name, changes, "");
+    }
+
+    flow undo(self, session: string, edit: string) -> ChangeOutcome
+        ![CommandOperations, Memory, Console, Command.run<DefaultCommandSandbox>, Fs.read<ProjectRoot>, Fs.list<ProjectRoot>, Fs.atomic_replace<ProjectRoot>, Error<StorageError>, Error<MemoryConflict>, Error<FileError>, Error<ReadLimitError>, Error<ConsoleError>, Error<BudgetExceeded>] {
+        return handlers.execute(self.files, self.journals, self.history, self.output, session, "undo", "", [], edit);
+    }
+
+    flow rollback(self, session: string, edit: string) -> ChangeOutcome
+        ![CommandOperations, Memory, Console, Command.run<DefaultCommandSandbox>, Fs.read<ProjectRoot>, Fs.list<ProjectRoot>, Fs.atomic_replace<ProjectRoot>, Error<StorageError>, Error<MemoryConflict>, Error<FileError>, Error<ReadLimitError>, Error<ConsoleError>, Error<BudgetExceeded>] {
+        return handlers.execute(self.files, self.journals, self.history, self.output, session, "rollback", "", [], edit);
+    }
+
+    flow reconcile(self, session: string, edit: string) -> ChangeOutcome
+        ![CommandOperations, Memory, Console, Command.run<DefaultCommandSandbox>, Fs.read<ProjectRoot>, Fs.list<ProjectRoot>, Fs.atomic_replace<ProjectRoot>, Error<StorageError>, Error<MemoryConflict>, Error<FileError>, Error<ReadLimitError>, Error<ConsoleError>, Error<BudgetExceeded>] {
+        return handlers.execute(self.files, self.journals, self.history, self.output, session, "reconcile", "", [], edit);
+    }
+
+    flow replace(self, session: string, change: FileChange) -> FileOutcome
+        ![CommandOperations, Memory, Console, Command.run<DefaultCommandSandbox>, Fs.read<ProjectRoot>, Fs.list<ProjectRoot>, Fs.atomic_replace<ProjectRoot>, Error<StorageError>, Error<MemoryConflict>, Error<FileError>, Error<ReadLimitError>, Error<ConsoleError>, Error<BudgetExceeded>] {
+        return handlers.replace(self.files, self.journals, self.history, self.output, session, change);
+    }
+
+    flow list(self, session: string) -> Array<Journal>
+        ![CommandOperations, Memory, Console, Command.run<DefaultCommandSandbox>, Fs.read<ProjectRoot>, Fs.list<ProjectRoot>, Fs.atomic_replace<ProjectRoot>, Error<StorageError>, Error<MemoryConflict>, Error<FileError>, Error<ReadLimitError>, Error<ConsoleError>, Error<BudgetExceeded>] {
+        return handlers.list(self.files, self.journals, self.history, self.output, session, false);
+    }
+
+    flow inspect(self, session: string) -> Array<Journal>
+        ![CommandOperations, Memory, Console, Command.run<DefaultCommandSandbox>, Fs.read<ProjectRoot>, Fs.list<ProjectRoot>, Fs.atomic_replace<ProjectRoot>, Error<StorageError>, Error<MemoryConflict>, Error<FileError>, Error<ReadLimitError>, Error<ConsoleError>, Error<BudgetExceeded>] {
+        return handlers.list(self.files, self.journals, self.history, self.output, session, true);
+    }
+}
