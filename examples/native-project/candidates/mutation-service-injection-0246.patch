+        return execute(self.files, self.journals, self.history, self.output, session, "reconcile", "", [], edit);
+    }
+
+    flow replace(self, session: string, change: FileChange) -> FileOutcome
+        ![CommandOperations, Memory, Console, Command.run<DefaultCommandSandbox>, Fs.read<ProjectRoot>, Fs.list<ProjectRoot>, Fs.atomic_replace<ProjectRoot>, Error<StorageError>, Error<MemoryConflict>, Error<FileError>, Error<ReadLimitError>, Error<ConsoleError>, Error<BudgetExceeded>] {
+        return replace(self.files, self.journals, self.history, self.output, session, change);
+    }
+
+    flow list(self, session: string) -> Array<Journal>
+        ![CommandOperations, Memory, Console, Command.run<DefaultCommandSandbox>, Fs.read<ProjectRoot>, Fs.list<ProjectRoot>, Fs.atomic_replace<ProjectRoot>, Error<StorageError>, Error<MemoryConflict>, Error<FileError>, Error<ReadLimitError>, Error<ConsoleError>, Error<BudgetExceeded>] {
+        return list(self.files, self.journals, self.history, self.output, session, false);
+    }
+
+    flow inspect(self, session: string) -> Array<Journal>
+        ![CommandOperations, Memory, Console, Command.run<DefaultCommandSandbox>, Fs.read<ProjectRoot>, Fs.list<ProjectRoot>, Fs.atomic_replace<ProjectRoot>, Error<StorageError>, Error<MemoryConflict>, Error<FileError>, Error<ReadLimitError>, Error<ConsoleError>, Error<BudgetExceeded>] {
+        return list(self.files, self.journals, self.history, self.output, session, true);
+    }
+}
