@@ -0,0 +1,31 @@
+module nomo.bootstrap.native;
+
+import nomo.native.entry;
+import nomo.native.projects.LaunchRoot;
+import std.effects.Fs;
+import std.fs.{ReadLimitError, IOError as FileError};
+import std.io.IOError;
+import nomo.native.workspace.ProjectRoot;
+import nomo.application.native.mutations.ports.ChangeOperations;
+import nomo.adapters.workspace.mutation_files.ProjectMutationFiles;
+import nomo.adapters.etas.change_journals.NativeChangeJournals;
+import nomo.adapters.etas.mutation_history.NativeMutationHistory;
+import nomo.adapters.terminal.mutations.TerminalMutationOutput;
+import nomo.bootstrap.mutations;
+
+public flow run(args: Array<string>) -> i32
+    ![Agentic, Memory, Console, Command.run<DefaultCommandSandbox>, Command.start<DefaultCommandSandbox>, Command.reconnect<DefaultCommandSandbox>, Command.read<DefaultCommandSandbox>, Command.write<DefaultCommandSandbox>, Command.stop<DefaultCommandSandbox>, Fs.read<ProjectRoot>, Fs.list<ProjectRoot>, Fs.stat<ProjectRoot>, Fs.atomic_replace<ProjectRoot>, Fs.atomic_replace<LaunchRoot>, Error<StorageError>, Error<MemoryConflict>, Error<FileError>, Error<ReadLimitError>, Error<IOError>, Error<IndexError>] {
+    let files = ProjectMutationFiles {};
+    let journals = NativeChangeJournals {};
+    let history = NativeMutationHistory {};
+    let output = TerminalMutationOutput {};
+    return handle { entry.run(args) } with {
+        ChangeOperations.apply(session, name, changes) => { resume mutations.execute(files, journals, history, output, session, "apply", name, changes, ""); }
+        ChangeOperations.undo(session, edit) => { resume mutations.execute(files, journals, history, output, session, "undo", "", [], edit); }
+        ChangeOperations.rollback(session, edit) => { resume mutations.execute(files, journals, history, output, session, "rollback", "", [], edit); }
+        ChangeOperations.reconcile(session, edit) => { resume mutations.execute(files, journals, history, output, session, "reconcile", "", [], edit); }
+        ChangeOperations.replace(session, change) => { resume mutations.replace(files, journals, history, output, session, change); }
+        ChangeOperations.list(session) => { resume mutations.list(files, journals, history, output, session, false); }
+        ChangeOperations.inspect(session) => { resume mutations.list(files, journals, history, output, session, true); }
+    };
+}
