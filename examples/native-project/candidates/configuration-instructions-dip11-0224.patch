+module nomo.adapters.configuration.converter;
+
+import std.io.IOError as ConsoleError;
+import nomo.application.native.configuration.ports.TomlConverter;
+import nomo.domain.configuration.conversion.{Converted, ConfigurationOutput};
+import nomo.native.history.SessionContext;
+import nomo.native.workspace.execute_readonly_input;
+
+public type TaploConfigurationConverter = {};
+impl TaploConfigurationConverter ~ TomlConverter {
+    flow toml(self, raw: string) -> Converted ![SessionContext, Memory, Console, Command.run<DefaultCommandSandbox>, Error<StorageError>, Error<MemoryConflict>, Error<ConsoleError>] {
+        let value = execute_readonly_input("project_configuration", "/home/nomo/.cargo/nomo-native-tools/taplo-0.10.0/bin/taplo", ["get", "-o", "json"], raw);
+        return Converted { result_event = value.result_event, output = ConfigurationOutput { exit_code = value.output.exit_code, stdout = value.output.stdout, stderr = value.output.stderr } };
+    }
+    flow entries(self, json: string) -> Converted ![SessionContext, Memory, Console, Command.run<DefaultCommandSandbox>, Error<StorageError>, Error<MemoryConflict>, Error<ConsoleError>] {
+        let value = execute_readonly_input("configuration_entries", "/usr/bin/jq", ["-c", "walk(if type == \"object\" then to_entries else . end)"], json);
+        return Converted { result_event = value.result_event, output = ConfigurationOutput { exit_code = value.output.exit_code, stdout = value.output.stdout, stderr = value.output.stderr } };
+    }
+}
diff --git a/src/nomo/adapters/etas/configuration_cache.es b/src/nomo/adapters/etas/configuration_cache.es
new file mode 100644
--- /dev/null
+++ b/src/nomo/adapters/etas/configuration_cache.es
@@ -0,0 +1,21 @@
+module nomo.adapters.etas.configuration_cache;
+
+import nomo.application.native.configuration.ports.ConfigurationCacheStore;
+import nomo.domain.configuration.conversion.CacheReference;
+import nomo.native.configuration.Cached;
+
+alias Schema = MemoryRegion<{ Parsed: Store<string, Cached> }>;
+let Data = std.memory.region<Schema>(stable_id = "nomo-native-configuration-v1", store = "native-configuration");
+
+public type NativeConfigurationCache = {};
+impl NativeConfigurationCache ~ ConfigurationCacheStore {
+    flow lookup(self, workspace: string) -> Option<CacheReference> ![Memory, Error<StorageError>] {
+        return match Data.Parsed.get(workspace) {
+            Some(value) => Some(CacheReference { digest = value.digest, session = value.session, result_event = value.result_event }),
+            None() => None()
+        };
+    }
+    flow remember(self, workspace: string, value: CacheReference) -> unit ![Memory, Error<StorageError>, Error<MemoryConflict>] {
+        Data.Parsed.put(workspace, Cached { digest = value.digest, session = value.session, result_event = value.result_event });
+    }
+}
diff --git a/src/nomo/adapters/workspace/instructions.es b/src/nomo/adapters/workspace/instructions.es
new file mode 100644
--- /dev/null
+++ b/src/nomo/adapters/workspace/instructions.es
@@ -0,0 +1,22 @@
+module nomo.adapters.workspace.instructions;
+
+import std.fs.{path, list, relative_name, ReadLimitError, IOError as FileError};
+import std.effects.Fs;
+import nomo.application.native.instructions.ports.InstructionFileSource;
+import nomo.native.workspace.ProjectRoot;
+import nomo.native.file_io.read_text;
+
+public type ProjectInstructionFiles = {};
+impl ProjectInstructionFiles ~ InstructionFileSource {
+    flow normalize(self, pathname: string) -> string ![] {
+        let selected = match path<ProjectRoot>(pathname) { Ok(value) => value, Err(_) => { abort("invalid project instruction path"); } };
+        return relative_name(selected);
+    }
+    flow entries(self, scope: string) -> Array<string> ![Fs.list<ProjectRoot>, Error<FileError>] {
+        let selected = match path<ProjectRoot>(scope) { Ok(value) => value, Err(_) => { abort("invalid project instruction path"); } };
+        var result: Array<string> = [];
+        for item in list(selected) limit Iterations(2147483647) { result = result.push(relative_name(item)); }
+        return result;
+    }
+    flow text(self, pathname: string) -> string ![Fs.read<ProjectRoot>, Error<FileError>, Error<ReadLimitError>] { return read_text(pathname); }
+}
diff --git a/src/nomo/bootstrap/configuration.es b/src/nomo/bootstrap/configuration.es
new file mode 100644
--- /dev/null
+++ b/src/nomo/bootstrap/configuration.es
@@ -0,0 +1,32 @@
+module nomo.bootstrap.configuration;
+
+import std.effects.Fs;
+import std.fs.{ReadLimitError, IOError as FileError};
+import std.io.IOError as ConsoleError;
+import nomo.native.workspace.ProjectRoot;
+import nomo.native.history.SessionContext;
+import nomo.domain.configuration.settings.Settings;
+import nomo.application.native.configuration.ports.{ConfigurationFile, EntriesCodec, TomlConverter, ConfigurationCacheStore, ConfigurationSource, ConfigurationCodec, ConfigurationConversion, ConfigurationCache};
+import nomo.application.native.configuration.service.load as load_configuration;
+import nomo.adapters.configuration.file.ProjectConfigurationFile;
+import nomo.adapters.configuration.codec.JsonConfigurationCodec;
+import nomo.adapters.configuration.converter.TaploConfigurationConverter;
+import nomo.adapters.etas.configuration_cache.NativeConfigurationCache;
+import nomo.adapters.etas.conversations.NativeHistory;
+
+public flow load() -> Settings ![SessionContext, Memory, Console, Command.run<DefaultCommandSandbox>, Fs.read<ProjectRoot>, Fs.list<ProjectRoot>, Error<StorageError>, Error<MemoryConflict>, Error<ConsoleError>, Error<FileError>, Error<ReadLimitError>] {
+    let source = ProjectConfigurationFile {};
+    let codec = JsonConfigurationCodec {};
+    let conversion = TaploConfigurationConverter {};
+    let cache = NativeConfigurationCache {};
+    return load_configuration(NativeHistory {}) with {
+        ConfigurationSource.read() => { resume source.read(); }
+        ConfigurationCodec.fingerprint(raw) => { resume codec.fingerprint(raw); }
+        ConfigurationCodec.decode_json(text) => { resume codec.decode_json(text); }
+        ConfigurationCodec.observation(text) => { resume codec.observation(text); }
+        ConfigurationConversion.toml(raw) => { resume conversion.toml(raw); }
+        ConfigurationConversion.entries(json) => { resume conversion.entries(json); }
+        ConfigurationCache.lookup(workspace) => { resume cache.lookup(workspace); }
+        ConfigurationCache.remember(workspace, value) => { cache.remember(workspace, value); resume; }
+    };
+}
diff --git a/src/nomo/bootstrap/instructions.es b/src/nomo/bootstrap/instructions.es
new file mode 100644
--- /dev/null
+++ b/src/nomo/bootstrap/instructions.es
@@ -0,0 +1,26 @@
+module nomo.bootstrap.instructions;
+
+import std.effects.Fs;
+import std.fs.{ReadLimitError, IOError as FileError};
+import nomo.native.workspace.ProjectRoot;
+import nomo.domain.context.instructions.ProjectInstruction;
+import nomo.application.native.context.ports.InstructionReader;
+import nomo.application.native.instructions.ports.{InstructionFileSource, InstructionFiles};
+import nomo.application.native.instructions.service.load as read_guidance;
+import nomo.adapters.workspace.instructions.ProjectInstructionFiles;
+
+public type ProjectGuidance = { files: ProjectInstructionFiles };
+impl ProjectGuidance ~ InstructionReader {
+    flow read(self, path: string) -> Array<ProjectInstruction> ![Fs.read<ProjectRoot>, Fs.list<ProjectRoot>, Error<FileError>, Error<ReadLimitError>] {
+        return read_guidance(path) with {
+            InstructionFiles.normalize(name) => { resume self.files.normalize(name); }
+            InstructionFiles.entries(scope) => { resume self.files.entries(scope); }
+            InstructionFiles.text(name) => { resume self.files.text(name); }
+        };
+    }
+}
+
+public flow reader() -> ProjectGuidance { return ProjectGuidance { files = ProjectInstructionFiles {} }; }
+public flow load(path: string) -> Array<ProjectInstruction> ![Fs.read<ProjectRoot>, Fs.list<ProjectRoot>, Error<FileError>, Error<ReadLimitError>] {
+    return reader().read(path);
+}
