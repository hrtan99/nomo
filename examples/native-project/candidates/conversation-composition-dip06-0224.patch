+module nomo.adapters.model.native;
+
+import std.effects.Fs;
+import std.fs.{ReadLimitError, IOError as FileError};
+import std.io.IOError as ConsoleError;
+import nomo.native.workspace.ProjectRoot;
+import nomo.native.history.SessionContext;
+import nomo.application.native.configuration.context.SettingsContext;
+import nomo.domain.conversation.turn.{Turn, Answer, Summary};
+import nomo.application.native.conversation.model.{CodingModel, SummaryModel};
+import nomo.native.agent.NativeCoding;
+import nomo.native.context.CompactHistory;
+
+public type NativeCodingModel = {};
+impl NativeCodingModel ~ CodingModel {
+    flow code(self, input: Turn) -> Answer ![SessionContext, SettingsContext, Memory, Command.run<DefaultCommandSandbox>, Command.start<DefaultCommandSandbox>, Command.reconnect<DefaultCommandSandbox>, Command.read<DefaultCommandSandbox>, Command.write<DefaultCommandSandbox>, Command.stop<DefaultCommandSandbox>, Console, Fs.read<ProjectRoot>, Fs.list<ProjectRoot>, Fs.stat<ProjectRoot>, Fs.atomic_replace<ProjectRoot>, Error<StorageError>, Error<MemoryConflict>, Error<FileError>, Error<ReadLimitError>, Error<ConsoleError>] {
+        return NativeCoding.run(input);
+    }
+}
+
+public type NativeSummaryModel = {};
+impl NativeSummaryModel ~ SummaryModel {
+    flow summarize(self, input: Turn) -> Summary ![] { return CompactHistory.run(input); }
+}
diff --git a/src/nomo/bootstrap/conversation.es b/src/nomo/bootstrap/conversation.es
new file mode 100644
--- /dev/null
+++ b/src/nomo/bootstrap/conversation.es
@@ -0,0 +1,74 @@
+module nomo.bootstrap.conversation;
+
+import std.io.{println, IOError as ConsoleError};
+import std.effects.Fs;
+import std.fs.{ReadLimitError, IOError as FileError};
+import nomo.native.workspace.ProjectRoot;
+import nomo.adapters.etas.conversations.NativeHistory;
+import nomo.adapters.etas.attempts.NativeAttempts;
+import nomo.adapters.etas.context_inputs.{NativeInstructions, NativeJobs};
+import nomo.adapters.model.native.{NativeCodingModel, NativeSummaryModel};
+import nomo.application.native.context.ports.{InstructionReader, SavedJobsReader};
+import nomo.application.native.conversation.model.{CodingModel, SummaryModel, ConversationModel, ConversationOutput};
+import nomo.application.native.context.effects.ConversationContext;
+import nomo.application.native.context.acquire.build;
+import nomo.application.native.conversation.controller.{turn, compact as compact_conversation, ready, supported};
+import nomo.application.native.configuration.context.SettingsContext;
+import nomo.domain.context.projection.RollingContext;
+import nomo.domain.configuration.settings.Settings;
+import nomo.native.configuration.load as load_configuration;
+import nomo.native.history.SessionContext;
+
+// Dependencies are constructed for this invocation. Settings/session are supplied
+// to each operation, never retained as ambient state across conversation turns.
+type Runtime = { history: NativeHistory, attempts: NativeAttempts, instructions: NativeInstructions,
+    jobs: NativeJobs, coding: NativeCodingModel, summary: NativeSummaryModel, projection: RollingContext };
+
+flow runtime() -> Runtime {
+    return Runtime { history = NativeHistory {}, attempts = NativeAttempts {}, instructions = NativeInstructions {},
+        jobs = NativeJobs {}, coding = NativeCodingModel {}, summary = NativeSummaryModel {}, projection = RollingContext {} };
+}
+
+public flow settings_for(session: string) -> Settings
+    ![Memory, Console, Command.run<DefaultCommandSandbox>, Fs.read<ProjectRoot>, Fs.list<ProjectRoot>, Error<StorageError>, Error<MemoryConflict>, Error<ConsoleError>, Error<FileError>, Error<ReadLimitError>] {
+    return handle { load_configuration() } with { SessionContext.current() => { resume session; } };
+}
+
+public flow ready_for_turn(session: string) -> bool {
+    return ready(NativeAttempts {}, session) with { ConversationOutput.write(line) => { println(line); resume; } };
+}
+
+public flow generation_supported(settings: Settings) -> bool {
+    return supported(settings) with { ConversationOutput.write(line) => { println(line); resume; } };
+}
+
+public flow ask(session: string, request: string) -> bool
+    ![Agentic, Memory, Console, Command.run<DefaultCommandSandbox>, Command.start<DefaultCommandSandbox>, Command.reconnect<DefaultCommandSandbox>, Command.read<DefaultCommandSandbox>, Command.write<DefaultCommandSandbox>, Command.stop<DefaultCommandSandbox>, Fs.read<ProjectRoot>, Fs.list<ProjectRoot>, Fs.stat<ProjectRoot>, Fs.atomic_replace<ProjectRoot>, Error<StorageError>, Error<MemoryConflict>, Error<FileError>, Error<ReadLimitError>, Error<ConsoleError>] {
+    let dependencies = runtime();
+    return turn(dependencies.history, dependencies.history, dependencies.history, dependencies.attempts, dependencies.history, dependencies.projection, session, request) with {
+        ConversationContext.settings(selected) => { resume settings_for(selected); }
+        ConversationContext.acquire(selected, task, settings) => {
+            resume build(dependencies.history, dependencies.instructions, dependencies.attempts, dependencies.jobs, selected, task, settings);
+        }
+        ConversationModel.code(input) => {
+            let answer = handle { dependencies.coding.code(input) } with {
+                SessionContext.current() => { resume input.session; }
+                SettingsContext.current() => { resume input.settings; }
+            };
+            resume answer;
+        }
+        ConversationModel.summarize(input) => { resume dependencies.summary.summarize(input); }
+        ConversationOutput.write(line) => { println(line); resume; }
+    };
+}
+
+public flow compact(session: string, settings: Settings) -> unit
+    ![Agentic, Memory, Fs.read<ProjectRoot>, Fs.list<ProjectRoot>, Error<StorageError>, Error<MemoryConflict>, Error<FileError>, Error<ReadLimitError>] {
+    let dependencies = runtime();
+    compact_conversation(dependencies.history, dependencies.history, dependencies.attempts, dependencies.history, dependencies.projection, session, settings) with {
+        ConversationContext.acquire(selected, task, configuration) => {
+            resume build(dependencies.history, dependencies.instructions, dependencies.attempts, dependencies.jobs, selected, task, configuration);
+        }
+        ConversationModel.summarize(input) => { resume dependencies.summary.summarize(input); }
+    };
+}
