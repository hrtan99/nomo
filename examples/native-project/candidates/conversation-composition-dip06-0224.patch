+module nomo.adapters.etas.context_inputs;
+
+import std.effects.Fs;
+import std.fs.{ReadLimitError, IOError as FileError};
+import nomo.application.native.context.ports.{InstructionReader, SavedJobsReader};
+import nomo.domain.context.instructions.ProjectInstruction;
+import nomo.domain.process.jobs.Job;
+import nomo.native.workspace.ProjectRoot;
+import nomo.native.project.load_instructions;
+import nomo.native.processes.jobs as saved_jobs;
+
+public type NativeInstructions = {};
+impl NativeInstructions ~ InstructionReader {
+    flow read(self, path: string) -> Array<ProjectInstruction> ![Fs.read<ProjectRoot>, Fs.list<ProjectRoot>, Error<FileError>, Error<ReadLimitError>] {
+        return load_instructions(path);
+    }
+}
+
+public type NativeJobs = {};
+impl NativeJobs ~ SavedJobsReader {
+    flow read(self, session: string) -> Array<Job> ![Memory, Error<StorageError>] {
+        var result: Array<Job> = [];
+        for value in saved_jobs(session) limit Iterations(2147483647) {
+            result = result.push(Job { id = value.id, session = value.session, program = value.program,
+                arguments = value.arguments, handle = value.handle, phase = value.phase });
+        }
+        return result;
+    }
+}
