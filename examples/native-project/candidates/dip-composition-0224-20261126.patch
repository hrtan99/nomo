diff --git a/src/nomo/adapters/command/foreground.es b/src/nomo/adapters/command/foreground.es
new file mode 100644
--- /dev/null
+++ b/src/nomo/adapters/command/foreground.es
@@ -0,0 +1,31 @@
+module nomo.adapters.command.foreground;
+
+import std.fs.path;
+import std.host.command.{Command as HostCommand, run as run_native};
+import std.codec.text.{utf8_decode, utf8_encode, Replace};
+import std.io.IOError;
+import nomo.native.workspace.ProjectRoot;
+import nomo.domain.execution.command.{CommandRequest, CommandOutput};
+import nomo.application.native.command.ports.CommandRunner;
+
+public type HostCommandRunner = {};
+
+flow text(value: bytes) -> string {
+    return match utf8_decode(value, Replace) {
+        Ok(decoded) => decoded,
+        Err(_) => { abort("command output decoding failed"); }
+    };
+}
+
+impl HostCommandRunner ~ CommandRunner {
+    flow run(self, request: CommandRequest) -> CommandOutput ![Command.run<DefaultCommandSandbox>, Error<IOError>] {
+        let root = match path<ProjectRoot>(".") {
+            Ok(value) => value,
+            Err(_) => { abort("project root is unavailable"); }
+        };
+        var selected = HostCommand.new(request.program, request.arguments).with_cwd(root);
+        match request.stdin { Some(value) => { selected = selected.with_stdin(utf8_encode(value)); } None() => {} }
+        let result = run_native(selected, DefaultCommandSandbox);
+        return CommandOutput { exit_code = result.exit_code, stdout = text(result.stdout), stderr = text(result.stderr) };
+    }
+}
diff --git a/src/nomo/adapters/command/processes.es b/src/nomo/adapters/command/processes.es
new file mode 100644
--- /dev/null
+++ b/src/nomo/adapters/command/processes.es
@@ -0,0 +1,30 @@
+module nomo.adapters.command.processes;
+
+import std.host.command.{Command as HostCommand, CommandHandle, CommandEvent, start, reconnect};
+import std.fs.{path, WorkspacePath};
+import nomo.native.workspace.ProjectRoot;
+import nomo.domain.process.observations.ProcessEvent;
+import nomo.application.native.processes.ports.ProcessControl;
+
+flow observed(value: CommandEvent) -> ProcessEvent {
+    return match value {
+        CommandEvent.Output(stdout, stderr) => ProcessEvent.Output(stdout, stderr),
+        CommandEvent.Exited(code, stdout, stderr) => ProcessEvent.Exited(code, stdout, stderr),
+        CommandEvent.Stopped(stdout, stderr) => ProcessEvent.Stopped(stdout, stderr)
+    };
+}
+public type HostProcessControl = {};
+impl HostProcessControl ~ ProcessControl<CommandHandle> {
+    flow root(self) -> WorkspacePath<ProjectRoot> ![] {
+        return match path<ProjectRoot>(".") { Ok(value) => value, Err(_) => { abort("project root is unavailable"); } };
+    }
+    flow start(self, root: WorkspacePath<ProjectRoot>, program: string, arguments: Array<string>) -> string ![Command.start<DefaultCommandSandbox>] {
+        let process = start(HostCommand.new(program, arguments).with_cwd(root), DefaultCommandSandbox);
+        return process.id();
+    }
+    flow attach(self, reference: string) -> CommandHandle ![Command.reconnect<DefaultCommandSandbox>] { return reconnect(reference, DefaultCommandSandbox); }
+    flow read(self, process: CommandHandle, max_bytes: usize) -> ProcessEvent ![Command.read<DefaultCommandSandbox>] { return observed(process.read(max_bytes)); }
+    flow write(self, process: CommandHandle, input: bytes) -> unit ![Command.write<DefaultCommandSandbox>] { process.write(input); }
+    flow close_input(self, process: CommandHandle) -> unit ![Command.write<DefaultCommandSandbox>] { process.close_stdin(); }
+    flow stop(self, process: CommandHandle) -> ProcessEvent ![Command.stop<DefaultCommandSandbox>] { return observed(process.stop()); }
+}
