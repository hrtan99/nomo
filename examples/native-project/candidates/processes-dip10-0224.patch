@@ -0,0 +1,25 @@
+module nomo.bootstrap.processes;
+
+import std.io.IOError;
+import nomo.application.native.processes.ports.ProcessOperations;
+import nomo.application.native.processes.service;
+import nomo.adapters.command.processes.HostProcessControl;
+import nomo.adapters.etas.processes.{NativeJobs, NativeOutputArchive};
+import nomo.adapters.terminal.processes.TerminalProcessPreview;
+import nomo.adapters.etas.conversations.NativeHistory;
+import nomo.adapters.etas.attempts.NativeAttempts;
+
+public flow bindings() -> ![ProcessOperations => Memory, Console, Command.start<DefaultCommandSandbox>, Command.reconnect<DefaultCommandSandbox>, Command.read<DefaultCommandSandbox>, Command.write<DefaultCommandSandbox>, Command.stop<DefaultCommandSandbox>, Error<StorageError>, Error<MemoryConflict>, Error<IOError>] ![] {
+    let control = HostProcessControl {};
+    let jobs = NativeJobs {}; let archive = NativeOutputArchive {};
+    let preview = TerminalProcessPreview {}; let history = NativeHistory {}; let attempts = NativeAttempts {};
+    return handler {
+        ProcessOperations.start(session, program, arguments) => { resume service.start(control, jobs, preview, attempts, history, history, history, session, program, arguments); }
+        ProcessOperations.read(session, job, max_bytes) => { resume service.read(control, jobs, archive, preview, attempts, history, history, history, session, job, max_bytes); }
+        ProcessOperations.write(session, job, input) => { resume service.write(control, jobs, preview, attempts, history, history, history, session, job, input); }
+        ProcessOperations.close_input(session, job) => { resume service.close_input(control, jobs, preview, attempts, history, history, history, session, job); }
+        ProcessOperations.stop(session, job) => { resume service.stop(control, jobs, archive, preview, attempts, history, history, history, session, job); }
+        ProcessOperations.list(session) => { resume service.list(jobs, session); }
+        ProcessOperations.output(session, job) => { resume service.output(jobs, archive, history, history, session, job); }
+    };
+}
