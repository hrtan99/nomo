@@ -0,0 +1,30 @@
+module nomo.adapters.command.processes;
+
+import std.host.command.{Command as HostCommand, CommandHandle, CommandEvent, start, reconnect};
+import std.fs.{path, WorkspacePath};
+import nomo.native.workspace.ProjectRoot;
+import nomo.domain.process.observations.ProcessEvent;
+import nomo.application.native.processes.ports.ProcessControl;
+
+flow observed(value: CommandEvent) -> ProcessEvent {
+    return match value {
+        CommandEvent.Output(stdout, stderr) => ProcessEvent.Output(stdout, stderr),
+        CommandEvent.Exited(code, stdout, stderr) => ProcessEvent.Exited(code, stdout, stderr),
+        CommandEvent.Stopped(stdout, stderr) => ProcessEvent.Stopped(stdout, stderr)
+    };
+}
+public type HostProcessControl = {};
+impl HostProcessControl ~ ProcessControl<CommandHandle> {
+    flow root(self) -> WorkspacePath<ProjectRoot> ![] {
+        return match path<ProjectRoot>(".") { Ok(value) => value, Err(_) => { abort("project root is unavailable"); } };
+    }
+    flow start(self, root: WorkspacePath<ProjectRoot>, program: string, arguments: Array<string>) -> string ![Command.start<DefaultCommandSandbox>] {
+        let process = start(HostCommand.new(program, arguments).with_cwd(root), DefaultCommandSandbox);
+        return process.id();
+    }
+    flow attach(self, reference: string) -> CommandHandle ![Command.reconnect<DefaultCommandSandbox>] { return reconnect(reference, DefaultCommandSandbox); }
+    flow read(self, process: CommandHandle, max_bytes: usize) -> ProcessEvent ![Command.read<DefaultCommandSandbox>] { return observed(process.read(max_bytes)); }
+    flow write(self, process: CommandHandle, input: bytes) -> unit ![Command.write<DefaultCommandSandbox>] { process.write(input); }
+    flow close_input(self, process: CommandHandle) -> unit ![Command.write<DefaultCommandSandbox>] { process.close_stdin(); }
+    flow stop(self, process: CommandHandle) -> ProcessEvent ![Command.stop<DefaultCommandSandbox>] { return observed(process.stop()); }
+}
diff --git a/src/nomo/adapters/etas/processes.es b/src/nomo/adapters/etas/processes.es
new file mode 100644
--- /dev/null
+++ b/src/nomo/adapters/etas/processes.es
@@ -0,0 +1,42 @@
+module nomo.adapters.etas.processes;
+
+import std.memory.MemoryCursor;
+import std.text.from_i64;
+import nomo.native.processes.{Data, Job as StoredJob, JobEvent as StoredEvent};
+import nomo.domain.process.jobs.{Job, JobEvent};
+import nomo.application.native.processes.ports.{JobRepository, OutputArchive};
+
+flow job(value: StoredJob) -> Job {
+    return Job { id = value.id, session = value.session, program = value.program, arguments = value.arguments, handle = value.handle, phase = value.phase };
+}
+flow stored_job(value: Job) -> StoredJob {
+    return StoredJob { id = value.id, session = value.session, program = value.program, arguments = value.arguments, handle = value.handle, phase = value.phase };
+}
+flow event(value: StoredEvent) -> JobEvent {
+    return JobEvent { job = value.job, call = value.call, phase = value.phase, exit_code = value.exit_code, stdout = value.stdout, stderr = value.stderr, stdout_bytes = value.stdout_bytes, stderr_bytes = value.stderr_bytes };
+}
+flow stored_event(value: JobEvent) -> StoredEvent {
+    return StoredEvent { job = value.job, call = value.call, phase = value.phase, exit_code = value.exit_code, stdout = value.stdout, stderr = value.stderr, stdout_bytes = value.stdout_bytes, stderr_bytes = value.stderr_bytes };
+}
+
+public type NativeJobs = {};
+impl NativeJobs ~ JobRepository {
+    flow load(self, id: string) -> Option<Job> ![Memory, Error<StorageError>] { return match Data.Jobs.get(id) { Some(value) => Some(job(value)), None() => None() }; }
+    flow insert(self, value: Job) -> unit ![Memory, Error<StorageError>, Error<MemoryConflict>] { Data.Jobs.insert(value.id, stored_job(value)); }
+    flow save(self, value: Job) -> unit ![Memory, Error<StorageError>, Error<MemoryConflict>] { Data.Jobs.put(value.id, stored_job(value)); }
+    flow list(self, session: string) -> Array<Job> ![Memory, Error<StorageError>] {
+        var result: Array<Job> = [];
+        var cursor: Option<MemoryCursor> = None();
+        while true limit Iterations(2147483647) {
+            let page = Data.Jobs.page(cursor, 100);
+            for item in page.entries limit Iterations(2147483647) { if item.value.session == session { result = result.push(job(item.value)); } }
+            match page.cursor { Some(value) => { cursor = Some(value); } None() => { break; } }
+        }
+        return result;
+    }
+}
+public type NativeOutputArchive = {};
+impl NativeOutputArchive ~ OutputArchive {
+    flow insert(self, session: string, call: i64, value: JobEvent) -> unit ![Memory, Error<StorageError>, Error<MemoryConflict>] { Data.Outputs.insert(session + ":" + from_i64(call), stored_event(value)); }
+    flow find(self, session: string, index: string) -> Option<JobEvent> ![Memory, Error<StorageError>] { return match Data.Outputs.get(session + ":" + index) { Some(value) => Some(event(value)), None() => None() }; }
+}
