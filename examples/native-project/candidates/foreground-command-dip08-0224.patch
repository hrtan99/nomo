+module nomo.application.native.command.encoding;
+
+import nomo.core.json.encode;
+import nomo.domain.execution.command.{CommandRequest, CommandPreview, CommandInput, CommandOutput};
+
+public flow request_text(request: CommandRequest) -> string {
+    let result = match request.stdin {
+        Some(value) => encode(CommandInput { program = request.program, arguments = request.arguments, stdin = value }, "history conversion failed", "history encoding failed"),
+        None() => encode(CommandPreview { program = request.program, arguments = request.arguments }, "history conversion failed", "history encoding failed")
+    };
+    return match result { Ok(value) => value, Err(error) => { abort(error); } };
+}
+
+public flow preview_text(request: CommandRequest) -> string {
+    let result = match request.stdin {
+        Some(value) => encode(CommandInput { program = request.program, arguments = request.arguments, stdin = value }, "command input conversion failed", "command input encoding failed"),
+        None() => encode(CommandPreview { program = request.program, arguments = request.arguments }, "command preview conversion failed", "command preview encoding failed")
+    };
+    return match result { Ok(value) => value, Err(error) => { abort(error); } };
+}
+
+public flow result_text(output: CommandOutput) -> string {
+    return match encode(output, "command result conversion failed", "command result encoding failed") {
+        Ok(value) => value, Err(error) => { abort(error); }
+    };
+}
+
+public flow step_result(output: CommandOutput) -> string {
+    return match encode(output, "history conversion failed", "history encoding failed") {
+        Ok(value) => value, Err(error) => { abort(error); }
+    };
+}
diff --git a/src/nomo/application/native/command/service.es b/src/nomo/application/native/command/service.es
new file mode 100644
--- /dev/null
+++ b/src/nomo/application/native/command/service.es
@@ -0,0 +1,31 @@
+module nomo.application.native.command.service;
+
+import std.io.IOError;
+import nomo.domain.execution.command.{CommandRequest, CommandOutput, CommandObservation, CommandMode, journal};
+import nomo.application.native.command.ports.{CommandRunner, CommandPreviewSink};
+import nomo.application.native.command.encoding.{request_text, result_text, step_result};
+import nomo.application.native.conversation.ports.{ConversationReader, ConversationWriter, ResultPublication};
+import nomo.application.native.execution.ports.AttemptRepository;
+import nomo.application.native.execution.service.{begin, dispatching, returned, complete_attempt};
+
+public flow run<R ~ CommandRunner, V ~ CommandPreviewSink, A ~ AttemptRepository, P ~ ResultPublication, C ~ ConversationReader, W ~ ConversationWriter>(runner: R, preview: V, repository: A, publication: P, history: C, writer: W, session: string, mode: CommandMode, request: CommandRequest) -> CommandObservation
+    ![Memory, Command.run<DefaultCommandSandbox>, Console, Error<StorageError>, Error<MemoryConflict>, Error<IOError>] {
+    let entry = journal(mode, request.program);
+    let call = writer.append(session, entry.role, entry.name, request_text(request), -1);
+    let attempt = begin(repository, session, entry.kind, entry.label, call, call);
+    dispatching(repository, attempt.id);
+    preview.show(request);
+    let output = runner.run(request);
+    let index = returned(repository, publication, attempt.id, "tool", entry.name, result_text(output), call);
+    complete_attempt(repository, publication, history, attempt.id);
+    return CommandObservation { result_event = index, output = output };
+}
+
+public flow step<R ~ CommandRunner, V ~ CommandPreviewSink, W ~ ConversationWriter>(runner: R, preview: V, writer: W, session: string, request: CommandRequest, parent: i64) -> CommandOutput
+    ![Memory, Command.run<DefaultCommandSandbox>, Console, Error<StorageError>, Error<MemoryConflict>, Error<IOError>] {
+    writer.append(session, "operation", "command", request_text(request), parent);
+    preview.show(request);
+    let output = runner.run(request);
+    writer.append(session, "operation_result", "command", step_result(output), parent);
+    return output;
+}
diff --git a/src/nomo/adapters/command/foreground.es b/src/nomo/adapters/command/foreground.es
new file mode 100644
