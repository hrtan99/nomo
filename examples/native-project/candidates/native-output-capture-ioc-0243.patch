diff --git a/src/nomo/adapters/storage/capture.es b/src/nomo/adapters/storage/capture.es
new file mode 100644
index 0000000..c134aa0
--- /dev/null
+++ b/src/nomo/adapters/storage/capture.es
@@ -0,0 +1,32 @@
+module nomo.adapters.storage.capture;
+
+import std.text.from_i64;
+import nomo.domain.process.capture.{CaptureHead, CaptureCursor};
+import nomo.domain.process.jobs.JobEvent;
+import nomo.application.processes.capture_ports.CaptureArchive;
+
+alias Schema = MemoryRegion<{ Heads: Store<string, CaptureHead>, Chunks: Store<string, JobEvent>, Cursors: Store<string, CaptureCursor> }>;
+let Captured = std.memory.region<Schema>(stable_id = "nomo-process-capture-v1", store = "process-capture");
+
+public type NativeCapture = {};
+impl NativeCapture ~ CaptureArchive {
+    flow head(self, job: string) -> Option<CaptureHead> ![Memory, Error<StorageError>] { return Captured.Heads.get(job); }
+    flow begin(self, job: string) -> unit ![Memory, Error<StorageError>, Error<MemoryConflict>] {
+        Captured.Heads.put(job, CaptureHead { events = 0, phase = "output" });
+    }
+    flow append(self, job: string, index: i64, value: JobEvent) -> unit ![Memory, Error<StorageError>, Error<MemoryConflict>] {
+        Captured.Chunks.insert(job + ":" + from_i64(index), value);
+        Captured.Heads.put(job, CaptureHead { events = index + 1, phase = value.phase });
+    }
+    flow chunk(self, job: string, index: i64) -> JobEvent ![Memory, Error<StorageError>] {
+        return match Captured.Chunks.get(job + ":" + from_i64(index)) {
+            Some(value) => value, None() => abort("captured process event is missing"),
+        };
+    }
+    flow cursor(self, job: string) -> CaptureCursor ![Memory, Error<StorageError>] {
+        return match Captured.Cursors.get(job) {
+            Some(value) => value, None() => CaptureCursor { event = 0, stdout = 0, stderr = 0 },
+        };
+    }
+    flow advance(self, job: string, value: CaptureCursor) -> unit ![Memory, Error<StorageError>, Error<MemoryConflict>] { Captured.Cursors.put(job, value); }
+}
diff --git a/src/nomo/application/processes/capture.es b/src/nomo/application/processes/capture.es
new file mode 100644
index 0000000..ae0600f
--- /dev/null
+++ b/src/nomo/application/processes/capture.es
@@ -0,0 +1,85 @@
+module nomo.application.processes.capture;
+
+import std.bytes.empty;
+import std.codec.text.{utf8_decode, Replace};
+import std.task.{run as task_run, start, try_join};
+import std.task.scheduler.SchedulerHandle;
+import nomo.application.processes.ports.{ProcessControl, JobRepository};
+import nomo.application.processes.capture_ports.{ProcessCapture, CaptureArchive};
+import nomo.domain.process.capture.{CaptureHead, CaptureCursor};
+import nomo.domain.process.jobs.{Job, JobEvent};
+import nomo.domain.process.observations.observed;
+
+public flow collect<Live, C ~ ProcessControl<Live>, J ~ JobRepository, R ~ CaptureArchive>(control: C, jobs: J, archive: R, job: Job, process: Live) -> i32
+    ![Memory, Command.read<DefaultCommandSandbox>, Error<StorageError>, Error<MemoryConflict>, Error<BudgetExceeded>] {
+    var index: i64 = 0;
+    @limits([Iterations(2147483647)]) while true {
+        let result = observed(job.id, -1, control.read(process, 65536));
+        archive.append(job.id, index, result);
+        index = index + 1;
+        if result.phase != "output" {
+            jobs.save(job { phase = result.phase });
+            return 0;
+        }
+    }
+    return 0;
+}
+
+type SessionClosed = { status: i32 };
+
+// The UI's typed scope outcome cancels and settles all owned collectors.
+public flow scope<Live, C ~ ProcessControl<Live>, J ~ JobRepository, R ~ CaptureArchive, effect E>(control: C, jobs: J, archive: R, body: () -> i32 ![ProcessCapture<Live>, E]) -> i32
+    ![Async, E, Memory, Command.read<DefaultCommandSandbox>, Error<StorageError>, Error<MemoryConflict>, Error<BudgetExceeded>] {
+    return task_run((scheduler: SchedulerHandle) => {
+        let ended = try_join<i32, SessionClosed>([() => {
+            let status = handle body() with {
+                ProcessCapture<Live>.register(job, process) => {
+                    archive.begin(job.id);
+                    let collector = start(() => collect(control, jobs, archive, job, process));
+                    ()
+                }
+            };
+            return perform Error<SessionClosed>.raise(SessionClosed { status });
+        }]);
+        return match ended { Err(value) => value.status, Ok(_) => 0 };
+    });
+}
+
+flow part(value: bytes, offset: usize, maximum: usize) -> bytes ![Error<IndexError>] {
+    let count = if maximum < value.length - offset { maximum } else { value.length - offset };
+    return value[offset, offset + count);
+}
+
+flow display(value: bytes) -> string {
+    return match utf8_decode(value, Replace) { Ok(text) => text, Err(_) => abort("process output conversion failed"), };
+}
+
+public flow next<R ~ CaptureArchive>(archive: R, job: string, call: i64, maximum: usize, head: CaptureHead) -> JobEvent {
+    if maximum == 0 { abort("max_bytes must be positive"); }
+    let cursor = archive.cursor(job);
+    if cursor.event >= head.events {
+        let phase = if head.phase == "output" { "no_saved_output" } else { head.phase };
+        let exit_code = if head.events > 0 && phase == "exited" { archive.chunk(job, head.events - 1).exit_code } else { None() };
+        return JobEvent { job, call, phase, exit_code, stdout = "", stderr = "", stdout_bytes = empty(), stderr_bytes = empty() };
+    }
+    let original = archive.chunk(job, cursor.event);
+    let stdout = part(original.stdout_bytes, cursor.stdout, maximum);
+    let stderr = part(original.stderr_bytes, cursor.stderr, maximum);
+    let out = cursor.stdout + stdout.length;
+    let err = cursor.stderr + stderr.length;
+    let complete = out == original.stdout_bytes.length && err == original.stderr_bytes.length;
+    archive.advance(job, if complete { CaptureCursor { event = cursor.event + 1, stdout = 0, stderr = 0 } }
+        else { CaptureCursor { event = cursor.event, stdout = out, stderr = err } });
+    return original { call, phase = if complete { original.phase } else { "output" }, exit_code = if complete { original.exit_code } else { None() },
+        stdout = display(stdout), stderr = display(stderr), stdout_bytes = stdout, stderr_bytes = stderr };
+}
+
+public flow snapshot<R ~ CaptureArchive>(archive: R, job: string, head: CaptureHead) -> Array<JobEvent> {
+    var result: Array<JobEvent> = [];
+    var index: i64 = 0;
+    @limits([Iterations(2147483647)]) while index < head.events {
+        result = result.push(archive.chunk(job, index));
+        index = index + 1;
+    }
+    return result;
+}
