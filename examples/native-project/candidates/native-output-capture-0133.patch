+PROGRAM = "import sys,time\nblock=('鹈鹕 café\\n'*4096).encode()\nfor _ in range(48):\n sys.stdout.buffer.write(block); sys.stdout.buffer.flush(); time.sleep(0.02)\nsys.stdin.readline()"
+ARGV = ['-u', '-c', PROGRAM]
+
+
+def value(raw):
+    kind = raw['kind']
+    if kind == 'record':
+        return {field['name']: value(field['value']) for field in raw['fields']}
+    if kind in ('int', 'uint'):
+        return int(raw['value'])
+    if kind == 'variant':
+        return {'name': raw['name'], 'fields': [value(item) for item in raw['fields']]}
+    return raw['value']
+
+
+def captured(database, job):
+    with sqlite3.connect(f'file:{database}?mode=ro', uri=True) as connection:
+        heads = connection.execute("SELECT region,key_json,value_json FROM memory_entries WHERE path LIKE '%Heads%'").fetchall()
+        match = next(((region, value(json.loads(body))) for region, key, body in heads if value(json.loads(key)) == job), None)
+        if match is None:
+            return b'', 0
+        region, head = match
+        chunks = connection.execute("SELECT key_json,value_json FROM memory_entries WHERE region=? AND path LIKE '%Chunks%'", (region,)).fetchall()
+    selected = {int(value(json.loads(key)).rsplit(':', 1)[1]): value(json.loads(body)) for key, body in chunks
+                if value(json.loads(key)).startswith(job + ':')}
+    return b''.join(bytes(selected[index]['stdout_bytes']) for index in range(head['events'])), head['events']
+
+
+def main():
+    evidence = Path(tempfile.mkdtemp(prefix='nomo-native-capture-')).resolve()
+    project = evidence / 'project'
+    project.mkdir(mode=0o700)
+    environment = dict(os.environ, MINIMAX_API_KEY='unused-no-model', NOMO_NATIVE_STATE=str(evidence / 'state'),
+                       NOMO_NATIVE_TRACE_ROOT=str(evidence / 'traces'))
+    command = [str(ROOT / 'scripts/nomo-native'), str(project)]
+
+    def approve(output):
+        preview = json.loads(next(line.split('[PROCESS] ', 1)[1] for line in reversed(output.decode().splitlines()) if '[PROCESS] ' in line))
+        assert preview == {'operation': 'start', 'program': '/usr/bin/python3', 'arguments': ARGV}, preview
+
+    print('EVIDENCE ' + str(evidence), flush=True)
+    first = Client(command, environment, evidence, 'first', approver=approve)
+    started = first.send('/spawn ' + json.dumps(['/usr/bin/python3', *ARGV]))
+    job = json.loads(next(line.split('[JOB    ] ', 1)[1] for line in started.splitlines() if '[JOB    ] ' in line))['id']
+    database = evidence / 'state/conversations.sqlite3'
+    deadline = time.monotonic() + 20
+    output, count = captured(database, job)
+    while len(output) < len(PAYLOAD) and time.monotonic() < deadline:
+        time.sleep(0.1)
+        output, count = captured(database, job)
+    # No /poll, input or model request has run during the capture interval.
+    first.leave()
+    assert output == PAYLOAD, (len(output), len(PAYLOAD), count)
+    trace_path = Path(next(line.split('[TRACE  ] ', 1)[1] for line in first.output.decode().splitlines() if '[TRACE  ] ' in line)) / 'trace.json'
+    trace = json.loads(trace_path.read_text())
+    assert trace['outcome']['kind'] == 'completed' and not audit(trace['events'])
+    reads = [item for item in trace['events'] if item['kind'] == 'host_request_started' and item.get('qualified_action') == 'Command.read']
+    assert len(reads) > 1 and first.approvals == 1
+    assert any(item['kind'] == 'task_cancellation_requested' for item in trace['events'])
+    assert not any(item.get('qualified_action', '').startswith('Agentic.') for item in trace['events'])
+    # A fresh Host reads a bounded prefix of the durable archive. It does not
+    # reconnect an old handle or infer that the old producer is still alive.
+    restored = Client(command, environment, evidence, 'restored', approver=approve)
+    result = restored.send('/poll ' + job + ' 17')
+    event = json.loads(next(line.split('[JOB    ] ', 1)[1] for line in result.splitlines() if '[JOB    ] ' in line))
+    assert bytes(event['stdout_bytes']) == PAYLOAD[:17] and event['phase'] == 'output', event
+    restored.leave()
+    assert restored.approvals == 0
+    result = {'status': 'passed', 'scope': 'actual native entry captures more than the Host buffer while the prompt waits; ordinary quit cancels a blocked reader; fresh Host consumes a bounded saved-byte prefix',
+              'bytes': len(output), 'sha256': hashlib.sha256(output).hexdigest(), 'captured_events': count,
+              'native_read_requests': len(reads), 'start_approvals': first.approvals,
+              'restored_approvals': restored.approvals, 'model_http_requests': 0,
+              'approval_audit': [], 'trace': str(trace_path)}
+    (evidence / 'functional.json').write_text(json.dumps(result, indent=2) + '\n')
+    print('PASS native continuous capture: ' + str(evidence), flush=True)
+
+
+if __name__ == '__main__':
+    main()
