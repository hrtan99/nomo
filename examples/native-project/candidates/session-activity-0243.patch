--- /dev/null
+++ b/src/nomo/domain/conversation/activity.es
@@ -0,0 +1,21 @@
+module nomo.domain.conversation.activity;
+
+import std.collections.sort_by;
+import nomo.domain.conversation.session.Session;
+
+// Old records have no timestamps; the missing past is not reconstructed.
+public type SessionActivity = { created: Option<i128>, updated: i128 };
+public type SessionListing = { session: Session, activity: Option<SessionActivity> };
+
+flow compare(left: Option<SessionActivity>, right: Option<SessionActivity>) -> i32 {
+    return match (left, right) {
+        (Some(a), Some(b)) => if a.updated > b.updated { -1 } else { if a.updated < b.updated { 1 } else { 0 } },
+        (Some(_), None()) => -1,
+        (None(), Some(_)) => 1,
+        (None(), None()) => 0,
+    };
+}
+
+public flow recent(entries: Array<SessionListing>) -> Array<SessionListing> {
+    return sort_by(entries, (left: SessionListing, right: SessionListing) => compare(left.activity, right.activity));
+}
