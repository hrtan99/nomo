@@ -0,0 +1,50 @@
+module app.main;
+
+import std.io.{println, IOError};
+import nomo.adapters.storage.conversations.NativeHistory;
+import nomo.application.conversation.ports.{ConversationReader, ConversationWriter, ConversationCatalog};
+import nomo.application.conversation.startup.select;
+import nomo.domain.conversation.start.SessionSelection;
+import nomo.adapters.cli.conversation_picker.ConsoleConversationPicker;
+import nomo.domain.serialization.json.encode;
+
+flow inspect() -> unit {
+    let history = NativeHistory {};
+    let chosen = match select(history, history, ConsoleConversationPicker {}, "activity-project", SessionSelection.Latest, false) {
+        Some(value) => value, None() => abort("latest selection cancelled"),
+    };
+    if chosen.id != "native-0" || history.selected("activity-project") != Some("native-1") {
+        abort("latest inspection changed or confused the selected conversation");
+    }
+    let current = match select(history, history, ConsoleConversationPicker {}, "activity-project", SessionSelection.Current, false) {
+        Some(value) => value, None() => abort("current selection cancelled"),
+    };
+    if current.id != "native-1" { abort("current selection lost its binding"); }
+    let sessions = history.sessions("activity-project");
+    if sessions.len() != 2 || sessions[0].session.id != chosen.id { abort("updated ordering changed"); }
+    let first = match sessions[0].activity { Some(value) => value, None() => abort("first activity missing") };
+    let second = match sessions[1].activity { Some(value) => value, None() => abort("second activity missing") };
+    if first.created == None() || second.created == None() || first.updated <= second.updated {
+        abort("recorded clock observations do not order the actual updates");
+    }
+    let text = match encode(sessions, "fixture conversion failed", "fixture encoding failed") {
+        Ok(value) => value, Err(error) => abort(error),
+    };
+    println("ACTIVITY " + text);
+}
+
+public flow main(args: Array<string>) -> i32 ![Memory, Console, Error<StorageError>, Error<MemoryConflict>, Error<IOError>, Error<IndexError>, Error<BudgetExceeded>] {
+    let history = NativeHistory {};
+    let first = history.create("activity-project", "First");
+    history.create("activity-project", "Second");
+    history.append(first.id, "user", "", "Continue the first conversation", -1);
+    inspect();
+    println("PASS latest update and selected binding remain independent");
+    return 0;
+}
+
+public flow restored(args: Array<string>) -> i32 ![Memory, Console, Error<StorageError>, Error<MemoryConflict>, Error<IOError>, Error<IndexError>, Error<BudgetExceeded>] {
+    inspect();
+    println("PASS restored session timestamps and selection");
+    return 0;
+}
