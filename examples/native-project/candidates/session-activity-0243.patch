+import json
+import subprocess
+import tempfile
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def main():
+    evidence = Path(tempfile.mkdtemp(prefix='nomo-native-session-activity-')).resolve()
+    package, state = evidence / 'package', evidence / 'state'
+    package.mkdir()
+    (package / '.etas').mkdir()
+    state.mkdir(mode=0o777)
+    state.chmod(0o777)
+    sources = copy_sources(ROOT, package, ROOT / 'tests/fixtures/native_session_activity/src/app/main.es')
+    (evidence / 'sources.json').write_text(json.dumps(sources, indent=2) + '\n')
+    (package / 'etas.toml').write_text('''[package]
+name="native-session-activity"
+version="0.1.0"
+edition="2026"
+[source]
+root="src"
+[runtime]
+default_profile="local"
+[runtime.profiles.local.memory]
+backend="sqlite"
+path="/state/history.sqlite3"
+[runtime.profiles.local.policy]
+mode="local-static"
+rules=["memory=allow","console=allow","clock:Clock.now=allow"]
+[[bin]]
+name="native-session-activity"
+module="app.main"
+flow="main"
+''')
+    (package / 'etas.lock').write_text('version=1\nmanifest_fingerprint="etas-lock-input:v1|package=native-session-activity|version=0.1.0|edition=2026"\npackage=[]\n')
+    overlay = evidence / 'compose.json'
+    overlay.write_text(json.dumps({'services': {'dev': {'volumes': [
+        {'type': 'bind', 'source': str(package), 'target': '/workspace', 'read_only': True},
+        {'type': 'bind', 'source': str(state), 'target': '/state'}]}}}))
+    command = ['docker', 'compose', '--env-file', '/dev/null']
+    for name in ('compose.yaml', 'config/etas-0243-official-compose.yaml', 'config/etas-runtime-cache-compose.yaml', str(overlay)):
+        command += ['--file', str(ROOT / name)]
+    inside = '''import json,subprocess
+cmd=['/home/nomo/.cargo/bin/etas','--no-config','--cache','off','run','/workspace','--allow-effects']
+records=[]
+for flow in ['main','restored']:
+ p=subprocess.run(cmd+['--flow',flow,'--trace-out','/state/'+flow+'.trace.json'],capture_output=True,text=True)
+ records.append({'flow':flow,'exit':p.returncode,'stdout':p.stdout,'stderr':p.stderr})
+ if p.returncode:break
+print(json.dumps(records))'''
+    command += ['run', '--rm', '--no-deps', '--pull', 'never', '--tty=false', 'dev', 'python3', '-c', inside]
+    print('EVIDENCE ' + str(evidence), flush=True)
+    result = subprocess.run(command, cwd=ROOT, capture_output=True, text=True, timeout=1800)
+    (evidence / 'container-stderr.txt').write_text(result.stderr)
+    assert result.returncode == 0, result.stderr
+    records = json.loads(result.stdout)
+    (evidence / 'result.json').write_text(json.dumps(records, indent=2) + '\n')
+    assert len(records) == 2 and all(item['exit'] == 0 and not item['stderr'] for item in records), records
+    assert records[0]['stdout'].splitlines()[-1] == 'PASS latest update and selected binding remain independent'
+    assert records[1]['stdout'].splitlines()[-1] == 'PASS restored session timestamps and selection'
+    snapshots = [json.loads(next(line[9:] for line in item['stdout'].splitlines() if line.startswith('ACTIVITY '))) for item in records]
+    assert snapshots[0] == snapshots[1]
+    for flow in ['main', 'restored']:
+        trace = json.loads((state / (flow + '.trace.json')).read_text())
+        assert trace['outcome']['kind'] == 'completed' and trace['termination']['local_work_settled']
+        starts = [item for item in trace['events'] if item['kind'] == 'host_request_started']
+        ends = [item for item in trace['events'] if item['kind'] == 'host_request_finished']
+        assert {item['id'] for item in starts} == {item['id'] for item in ends}
+        assert all(item['outcome']['kind'] == 'succeeded' for item in ends)
+        clocks = sum(item.get('qualified_action') == 'Clock.now' for item in starts)
+        assert clocks == (3 if flow == 'main' else 0), clocks
+    print('PASS native session activity and restored selection: ' + str(evidence), flush=True)
+
+
+if __name__ == '__main__':
+    main()
