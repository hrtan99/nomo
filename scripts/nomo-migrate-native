#!/usr/bin/env python3
"""Copy saved native or shipping project history into a fresh, unpublished native directory."""
import argparse
import json
import os
from pathlib import Path
import subprocess

from nomo_migration import digest, native_packet, project_packet, native_snapshots

ROOT = Path(__file__).resolve().parents[1]


def migrate(source, destination, source_format):
    trees = ('edits',) if source_format == 'native-0135' else ('edits', 'jobs')
    if any(destination.is_relative_to((source.parent / name).resolve()) for name in trees):
        raise ValueError('migration destination must be outside the source edit/job files')
    # A separate fresh directory is the publication boundary: no live selector is changed.
    destination.mkdir(mode=0o700)
    incoming, state, evidence = (destination / name for name in ('input', 'state', 'trace'))
    for directory in (incoming, state, evidence):
        directory.mkdir(mode=0o700)
    before = digest(source)
    reader = native_packet if source_format == 'native-0135' else project_packet
    image = reader(source, incoming / 'legacy-source.sqlite3')
    snapshots = native_snapshots(source, image, state) if source_format == 'native-0135' else None
    project_backup = (json.loads((incoming / 'project-files.json').read_text())
                      if source_format == 'project' else None)
    count = (len(image['rows']) if source_format == 'native-0135' else
             sum(1 + len(conversation['events']) for conversation in image['conversations']))
    snapshot = incoming / 'snapshot.json'
    snapshot.write_text(json.dumps(image, ensure_ascii=False, separators=(',', ':')) + '\n')
    snapshot.chmod(0o600)
    receipt = {'status': 'incomplete', 'source_database_sha256': before,
               'source_snapshot_sha256': image['source_sha256'], 'source_format': source_format, 'rows': count,
               'source': str(source), 'state': str(state),
               'snapshots': snapshots,
               'project_files_backup': project_backup,
               'scope': ('Native format-3 records only. Original receipts/CAS namespaces remain in the source backup; '
                         'fresh SDK writes establish new destination versions.' if source_format == 'native-0135' else
                         'Shipping project database only: original session IDs, full source archives, summary fences '
                         'and catalogue selection. Source event IDs map to native local positions; original IDs, '
                         'timestamps, parent, kind, data and measured usage remain in each source archive and backup. '
                         'Separate Python tool journals and job files are retained under input, but are not '
                         'imported as native journals/jobs. Bounded legacy sessions are not migrated. '
                         'The native allowance ledger begins at zero for new execution.') +
                        ' No command, model, recovery or live-handle replay.'}
    manifest = destination / 'migration.json'
    manifest.write_text(json.dumps(receipt, indent=2) + '\n')
    overlay = destination / 'compose.json'
    overlay.write_text(json.dumps({'services': {'dev': {'volumes': [
        {'type': 'bind', 'source': str(incoming), 'target': '/migration', 'read_only': True},
        {'type': 'bind', 'source': str(state), 'target': '/migration-target'},
        {'type': 'bind', 'source': str(evidence), 'target': '/migration-evidence'}]}},
        'volumes': {'cargo-cache': {'external': True}}}))
    command = ['docker', 'compose', '--project-name', 'nomo-native-migrate', '--env-file', '/dev/null']
    for name in ('compose.yaml', 'config/etas-0246-official-compose.yaml',
                 'config/local-tryout-compose.yaml', 'config/etas-runtime-cache-compose.yaml',
                 'config/nomo-native-launch-compose.yaml', str(overlay)):
        command += ['--file', str(ROOT / name)]
    command += ['run', '--rm', '--no-deps', '--pull', 'never', '--tty=false', 'dev',
                '/home/nomo/.cargo/bin/etas', '--no-config', '--cache', 'off', 'run', '/workspace',
                '--flow', 'native_state_migrate' if source_format == 'native-0135' else 'project_state_migrate', '--profile', 'nomo-native-migrate', '--allow-effects',
                '--trace-out', '/migration-evidence/trace.json']
    print('[MIGRATE] Prepared ' + str(count) + ' source rows; destination ' + str(destination), flush=True)
    environment = dict(os.environ, NOMO_NATIVE_UID=str(os.getuid()), NOMO_NATIVE_GID=str(os.getgid()))
    result = subprocess.run(command, cwd=ROOT, env=environment, stdin=subprocess.DEVNULL, capture_output=True, text=True)
    (destination / 'stdout.txt').write_text(result.stdout)
    (destination / 'stderr.txt').write_text(result.stderr)
    receipt.update(exit=result.returncode, source_database_after=digest(source))
    if result.returncode == 0:
        report = json.loads(next(line.removeprefix('[MIGRATE] ') for line in result.stdout.splitlines()
                                 if line.startswith('[MIGRATE] {')))
        if report['source_sha256'] != image['source_sha256'] or report['rows'] != count:
            raise RuntimeError('native migration did not confirm the complete source image')
        receipt.update(status='completed', report=report)
    manifest.write_text(json.dumps(receipt, indent=2) + '\n')
    if result.returncode:
        print(result.stderr or result.stdout, end='')
        print('[MIGRATE] Incomplete destination retained at ' + str(destination))
    else:
        label = 'Native state' if source_format == 'native-0135' else 'Conversation history and catalogue'
        print('[MIGRATE] ' + label + ' completed. Original source retained; launch with NOMO_NATIVE_STATE=' + str(state))
        if project_backup and project_backup['files']:
            print('[MIGRATE] Original Python edit/job files are backed up in ' + str(incoming) +
                  '; native edit/job restoration remains pending.')
    return result.returncode


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--from', dest='source_format', choices=('native-0135', 'project'), default='native-0135',
                        help='source format; stop old Nomo and finish/stop its background jobs before migration')
    parser.add_argument('source', type=Path, help='old conversations.sqlite3 or shipping project.sqlite3')
    parser.add_argument('destination', type=Path, help='new directory; it must not already exist')
    args = parser.parse_args()
    os.umask(0o077)
    return migrate(args.source.expanduser().resolve(), args.destination.expanduser().resolve(), args.source_format)


if __name__ == '__main__':
    raise SystemExit(main())
