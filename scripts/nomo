#!/usr/bin/env python3
"""Start a workspace session, or resume one by ID or workspace binding."""
import argparse
import importlib.util
import os
from pathlib import Path
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent
spec = importlib.util.spec_from_file_location('session_registry', ROOT/'scripts/nomo-session-id.py')
registry = importlib.util.module_from_spec(spec); spec.loader.exec_module(registry)


def private_dir(path, create):
    if not path.is_absolute() or path.is_symlink():
        raise ValueError('state directory must be absolute and not a symlink')
    if create:
        path.mkdir(mode=0o700, parents=True, exist_ok=True)
    base, fd = registry.registry(str(path))
    os.close(fd)
    return base


def state_paths(resume, workspace):
    default = Path(os.environ.get('XDG_STATE_HOME') or Path.home()/'.local/state')/'nomo'
    selected = Path(os.environ.get('NOMO_STATE_DIR') or default)
    candidate = selected.resolve()
    if workspace is not None and (candidate == workspace or candidate in workspace.parents or workspace in candidate.parents):
        raise ValueError('state and workspace must not overlap')
    base = private_dir(selected, not resume)
    sessions = private_dir(base/'sessions', not resume)
    policy = base/'policy'
    if not resume and not policy.exists() and not policy.is_symlink():
        if any(sessions.iterdir()):
            raise ValueError('policy missing for existing sessions; inspect state')
        policy.mkdir(mode=0o700)
        fd = os.open(policy/'policy.json', os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        try:
            data = b'{"format":1,"literals":["__NOMO_NO_SECRET_FILTER_CONFIGURED__"]}\n'
            if os.write(fd, data) != len(data):
                raise OSError('event policy write incomplete')
            os.fsync(fd)
        finally:
            os.close(fd)
        subprocess.run([sys.executable, str(ROOT/'scripts/nomo-event-policy.py'), 'init', '--directory', str(policy)], check=True)
    policy = private_dir(policy, False)
    return sessions, policy


def legacy_main():
    parser = argparse.ArgumentParser(description=__doc__, epilog='Set NOMO_STATE_DIR to select a private state directory. --latest resumes the most recently used compatible session bound to the current workspace. Explicit historical IDs remain usable but are not automatically bound. This revision uses ETAS 0.4.1; historical sessions retain their recorded budget versions.')
    parser.add_argument('--root', default=os.getcwd(), help='workspace directory (default: current directory)')
    selection = parser.add_mutually_exclusive_group()
    selection.add_argument('--id', help='resume this exact session ID')
    selection.add_argument('--latest', action='store_true', help='resume the latest compatible session for this workspace')
    parser.add_argument('--status', action='store_true', help='inspect the selected session offline')
    parser.add_argument('--events', action='store_true', help='include recorded events with --status')
    parser.add_argument('--once', help='run one read-only question')
    parser.add_argument('--high-input', action='store_true', help='new sessions only: full history with 131072 output tokens per model call')
    scope = parser.add_mutually_exclusive_group()
    scope.add_argument('--page', type=int, choices=range(8), help='initial discovery page, 0..7 (default: 0)')
    scope.add_argument('--allow', help='read only these one to four comma-separated relative files')
    parser.add_argument('--check', nargs=argparse.REMAINDER, help='offline command after a confirmed edit')
    args = parser.parse_args()
    if args.events and not args.status: parser.error('--events requires --status')
    if args.high_input and (args.id is not None or args.latest or args.status): parser.error('--high-input creates a new session and cannot be combined with --id, --latest or --status')
    if args.status and ((args.id is None and not args.latest) or args.once is not None or args.page is not None or args.allow is not None or args.check is not None):
        parser.error('--status requires --id or --latest and accepts no question, scope or check')
    if args.check == []:
        parser.error('--check requires a command')
    try:
        os.umask(0o077)
        if args.allow is not None and (len(args.allow.encode('utf-8')) > 515 or '*' in args.allow or not 1 <= len(args.allow.split(',')) <= 4 or not all(args.allow.split(','))):
            raise ValueError('--allow requires one to four explicit relative files')
        workspace = None if args.status and not args.latest else Path(args.root)
        if workspace is not None:
            if not workspace.is_dir() or workspace.is_symlink():
                raise ValueError('workspace must be an existing directory with a non-symlink leaf')
            workspace = workspace.resolve(strict=True)
        sessions, policy = state_paths(args.id is not None or args.latest, workspace)
        selected_id=args.id
        if args.latest:
            identity=registry.workspace_identity(str(workspace))
            _,fd=registry.registry(str(sessions))
            try:selected_id=registry.latest_compatible(fd,sessions,identity,str(policy))
            finally:os.close(fd)
            print('Selected latest compatible workspace session: '+selected_id,flush=True)
        if args.status:
            command = [str(ROOT/'scripts/nomo-read.sh'), 'session-id', 'status', '--sessions-dir', str(sessions), '--id', selected_id, '--events-policy-dir', str(policy), *(['--events'] if args.events else [])]
        else:
            print('Saved event text may contain sensitive data; no secret filter is configured by default.', flush=True)
            print(('Discovery is bounded and does not interpret .gitignore' if args.allow is None else 'Only explicitly selected files are in scope') + '; new sessions bind the canonical workspace path and directory identity.', flush=True)
            command = [str(ROOT/'scripts/nomo-read.sh'), 'session-chat', '--sessions-dir', str(sessions),
                       '--id='+selected_id if selected_id is not None else '--new', '--root', str(workspace),
                       *(['--discover', '--page', str(args.page or 0)] if args.allow is None else ['--allow='+args.allow]),
                       '--events-policy-dir', str(policy)]
            if args.once is not None:
                command += ['--once', args.once]
            if args.high_input:
                command += ['--high-input']
            if args.check is not None:
                command += ['--check', *args.check]
        os.execv(command[0], command)
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print('REFUSED ' + str(error), file=sys.stderr)
        return 1


def main():
    if '--legacy' in sys.argv or any(value == '--allow' or value.startswith('--allow=') or value == '--page' for value in sys.argv[1:]):
        if '--legacy' in sys.argv:
            sys.argv.remove('--legacy')
        return legacy_main()
    from nomo_project_chat import main as project_main
    return project_main()


if __name__ == '__main__':
    from nomo_terminal import install
    install()
    try:
        raise SystemExit(main())
    except (OSError, ValueError, RuntimeError) as error:
        print('ERROR ' + str(error), file=sys.stderr)
        raise SystemExit(1)
