#!/usr/bin/env python3
"""Start a workspace session, or resume one by its displayed ID."""
import argparse
import os
from pathlib import Path
import stat
import subprocess
import sys

ROOT = Path(__file__).resolve().parent.parent


def private_dir(path, create):
    if not path.is_absolute() or path.is_symlink():
        raise ValueError('state directory must be absolute and not a symlink')
    if create:
        path.mkdir(mode=0o700, parents=True, exist_ok=True)
    fd = os.open(path, os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW | os.O_CLOEXEC)
    try:
        info = os.fstat(fd)
        if info.st_uid != os.getuid() or stat.S_IMODE(info.st_mode) != 0o700:
            raise ValueError('state directories must be owned by you with mode 0700')
    finally:
        os.close(fd)
    return path.resolve(strict=True)


def state_paths(resume, workspace):
    default = Path(os.environ.get('XDG_STATE_HOME') or Path.home()/'.local/state')/'nomo'
    selected = Path(os.environ.get('NOMO_STATE_DIR') or default)
    candidate = selected.resolve()
    if candidate == workspace or candidate in workspace.parents or workspace in candidate.parents:
        raise ValueError('state and workspace must not overlap')
    base = private_dir(selected, not resume)
    sessions = private_dir(base/'sessions', not resume)
    policy = base/'policy'
    if not resume and not policy.exists() and not policy.is_symlink():
        if any(sessions.iterdir()):
            raise ValueError('policy missing for existing sessions; inspect state')
        policy.mkdir(mode=0o700)
        fd = os.open(policy/'policy.json', os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
        try:
            data = b'{"format":1,"literals":["__NOMO_NO_SECRET_FILTER_CONFIGURED__"]}\n'
            if os.write(fd, data) != len(data):
                raise OSError('event policy write incomplete')
            os.fsync(fd)
        finally:
            os.close(fd)
        subprocess.run([sys.executable, str(ROOT/'scripts/nomo-event-policy-init.py'), '--directory', str(policy)], check=True)
    policy = private_dir(policy, False)
    return sessions, policy


def main():
    parser = argparse.ArgumentParser(description=__doc__, epilog='Set NOMO_STATE_DIR to select a private state directory. --id resumes only that ID; it does not verify workspace identity. Set NOMO_ETAS_GRAPH=026-v68 for new-graph sessions; existing sessions retain their original graph.')
    parser.add_argument('--root', default=os.getcwd(), help='workspace directory (default: current directory)')
    parser.add_argument('--id', help='resume this exact session ID')
    parser.add_argument('--once', help='run one read-only question')
    parser.add_argument('--page', type=int, choices=range(8), default=0, help='initial discovery page, 0..7')
    parser.add_argument('--check', nargs=argparse.REMAINDER, help='offline command after a confirmed edit')
    args = parser.parse_args()
    if args.check == []:
        parser.error('--check requires a command')
    try:
        os.umask(0o077)
        workspace = Path(args.root)
        if not workspace.is_dir() or workspace.is_symlink():
            raise ValueError('workspace must be an existing directory with a non-symlink leaf')
        workspace = workspace.resolve(strict=True)
        sessions, policy = state_paths(args.id is not None, workspace)
        print('Saved event text may contain sensitive data; no secret filter is configured by default.', flush=True)
        print('Discovery is bounded and does not interpret .gitignore; session IDs do not verify workspace identity.', flush=True)
        command = [str(ROOT/'scripts/nomo-read.sh'), 'session-chat', '--sessions-dir', str(sessions),
                   '--id='+args.id if args.id is not None else '--new', '--root', str(workspace), '--discover', '--page', str(args.page),
                   '--events-policy-dir', str(policy)]
        if args.once is not None:
            command += ['--once', args.once]
        if args.check is not None:
            command += ['--check', *args.check]
        os.execv(command[0], command)
    except (OSError, ValueError, subprocess.CalledProcessError) as error:
        print('REFUSED ' + str(error), file=sys.stderr)
        return 1


if __name__ == '__main__':
    raise SystemExit(main())
